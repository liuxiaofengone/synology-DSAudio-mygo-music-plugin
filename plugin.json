{
  "id": "synology-audio",
  "name": "群晖 Audio Station",
  "version": "0.1.3",
  "minAppVersion": "0.1.8",
  "main": "index.js",
  "playback": "stream",
  "permissions": {
    "network": ["*"]
  },
  "settings": [
    {
      "key": "server",
      "label": "QuickConnect ID 或 服务器地址",
      "help": "支持填入 QuickConnect ID（如 mynas）或直连地址（如 192.168.1.100:5000 或 https://nas.example.com:5001）"
    },
    {
      "key": "username",
      "label": "用户名",
      "help": "DSM 登录用户名"
    },
    {
      "key": "password",
      "label": "密码",
      "type": "password",
      "help": "DSM 登录密码"
    },
    {
      "key": "otp",
      "label": "2FA 动态验证码 (可选)",
      "help": "若账号开启了两步验证，首次登录时在此填写 6 位动态验证码"
    },
    {
      "key": "transcode",
      "label": "高清音频外网转码策略",
      "type": "select",
      "help": "在外网或中继连接时，对超高码率无损音频启用群晖实时转码，彻底消除播放卡顿",
      "options": [
        { "value": "auto", "label": "智能自适应 (按客户端音质偏好与网络环境决策，推荐)" },
        { "value": "always", "label": "总是转码 (全环境转码为 320kbps 高品质 MP3)" },
        { "value": "lossless", "label": "始终原盘无损 (需大带宽网络支持)" }
      ]
    }
  ],
  "navigation": [
    { "title": "媒体库主页", "builtin": "home" },
    { "title": "全部歌曲", "page": "all_songs", "icon": "note" },
    { "title": "专辑列表", "page": "all_albums", "icon": "album" },
    { "title": "歌手列表", "page": "all_artists", "icon": "artist" },
    { "title": "文件夹", "page": "folder:root", "icon": "playlist" },
    { "title": "我的歌单", "page": "playlists", "icon": "playlist" },
    { "title": "我喜欢的音乐", "builtin": "liked" }
  ]
}
